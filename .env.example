# Copia este ficheiro para .env e preenche com os dados do teu projeto Firebase
# (Consola Firebase > Definições do projeto > As tuas apps > App Web > Config).
# Sem estes valores a app funciona só com o banco local do telefone.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# AdMob: IDs dos blocos de anúncio (Consola AdMob > Apps > Blocos de anúncios).
# Vazios = usa os anúncios de teste da Google.
EXPO_PUBLIC_ADMOB_BANNER_HOME=
EXPO_PUBLIC_ADMOB_BANNER_HISTORY=
